generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id       String  @id @default(uuid())
    email    String  @unique
    password String
    isActive Boolean @default(true)

    organization   String
    fullname       String
    bio            String?
    avatar         String?

    workspaceRoles      Role[]

    refreshToken    String?
    emailVerified   Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt 

    sentInvites     WorkspaceInvitation[] @relation("InvitationsSent")
    receivedInvites WorkspaceInvitation[] @relation("InvitationsReceived")
}

enum workStatus {
    Active
    Inactive
}

enum workRole {
    Admin
    Analyst
    Viewer
}

model Role {
    id          String @id @default(cuid())
    workspaceId String
    userId      String

    status      workStatus @default(Active)
    workRole    workRole

    workspaceUser User @relation(fields: [userId], references: [id], onDelete: Cascade)
    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([workspaceId])
}


model Workspace {
    id          String @id @default(cuid())
    title       String
    createdBy   String

    userRoles       Role[]
    dashboards      Dashboard[] 
    conversations   Conversation[]
    fileUploads     FileUpload[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    invites         WorkspaceInvitation[]
}


model Conversation {
    id          String @id @default(cuid())
    title       String
    workspaceId String

    messages Message[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    fileuploadId String? @unique

    fileUpload FileUpload? @relation(fields: [fileuploadId], references: [id], onDelete: Cascade)
    workspaceConversation Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([workspaceId])
}

enum senderType {
    User
    Ai
}

model Message {
    id      String @id @default(cuid())
    content String?

    conversationId  String?
    senderType      senderType
    senderName      String?
    sentAt          DateTime @default(now())
    dashboards      Json?

    conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId])
}


model Dashboard {
    id          String @id @default(cuid())
    title       String
    insights    String[]
    
    kpis        Json[]
    charts      Json[]
    chartData   Json[]

    workspaceId String?
    messageId   String?
    createdAt   DateTime @default(now())

    workspaceDashboard Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade) 
}

model FileUpload {
    id          String @id @default(cuid())
    filename    String
    uploadedBy  String
    size        String
    format      String
    workspaceId String
    supabaseFilePath   String
    createdAt   DateTime @default(now())
    
    conversation Conversation?
    workspaceFile Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}


enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model WorkspaceInvitation {
    id            String   @id @default(uuid())

    invitedToId   String
    invitedById   String
    workspaceId   String
    invitedRole   workRole

    status        InvitationStatus @default(PENDING)

    respondedAt DateTime?
    createdAt   DateTime @default(now())

    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

    invitedToUser User @relation( "InvitationsReceived", fields: [invitedToId], references: [id],onDelete: Cascade)
    invitedByUser User @relation("InvitationsSent",fields: [invitedById],references: [id],onDelete: Cascade)


    @@index([invitedToId])
    @@index([invitedById])
    @@index([workspaceId])
}