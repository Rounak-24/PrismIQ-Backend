generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id       String  @id @default(uuid())
    email    String  @unique
    password String
    isActive Boolean @default(true)

    organization   String
    fullname       String
    bio            String?
    avatar         String?

    workspaceRoles      Role[]
    fileUploads         FileUpload[]

    refreshToken   String?
    emailVeriified Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt 

}

enum workStatus {
    Active
    Inactive
}

enum workRole {
    Admin
    Analyst
    Viewer
}

model Role {
    id          String @id @default(cuid())
    workspaceId String
    userId      String

    status      workStatus @default(Active)
    workRole    workRole

    workspaceUser User @relation(fields: [userId], references: [id], onDelete: Cascade)
    workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}


model Workspace {
    id          String @id @default(cuid())
    title       String
    createdBy   String

    userRoles       Role[]
    dashboards      Dashboard[] 
    conversations   Conversation[]
    fileUploads     FileUpload[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model Conversation {
    id          String @id @default(cuid())
    title       String
    workspaceId String

    messages Message[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    workspaceConversation Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum senderType {
    USER
    AI
}

model Message {
    id      String @id @default(cuid())
    content String?

    conversationId  String
    senderType      senderType
    senderName      String?
    sentAt          DateTime @default(now())

    dashboards      Dashboard[]

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId])
}


model Dashboard {
    id          String @id @default(cuid())
    title       String
    insights    String[]
    
    kpis    Json[]
    charts  Json[]

    workspaceId String
    messageId   String?
    createdAt   DateTime @default(now())

    workspaceDashboard Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade) 
    message Message? @relation(fields: [messageId], references: [id])
}

model FileUpload {
    id          String @id @default(cuid())
    filename    String
    uploadedBy  String
    size        String
    format      String
    workspaceId String
    
    schema  Json[]

    fileUploader User @relation(fields: [uploadedBy], references: [id])
    workspaceFile Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}